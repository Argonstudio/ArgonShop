{
  "permissions": {
    "allow": [
      "Bash(php tests/static-check.php)",
      "Bash(php -l:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/static-check.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
